# Hawk-Eye FRONTEND environment (Vite). Copy to .env.local and adjust.
# All values are read via src/lib/env.ts — components never read import.meta.env directly.

# BACKEND REST API base (BACKEND.md §3, base path /api/v1). Backend serves on :8000 (CONTEXT.md).
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Mock Service Worker. When true, the typed apiClient is served by MSW against the Part 24.5
# sample payloads — the whole app runs with no backend. NEVER commit `true` as the default for
# integration/production builds (see .env.production). Local dev sets it in .env.development.
VITE_USE_MOCKS=false

# Keycloak 25.x OIDC (PLATFORM/BACKEND provision the realm + client). Issuer on :8080 (CONTEXT.md).
# Read from env, never hardcoded (prompt §7 M1 / FRONTEND-2).
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/hawk-eye
VITE_OIDC_CLIENT_ID=hawk-eye-console
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/login
VITE_OIDC_SCOPE=openid profile email

# Grafana 11.x ops dashboards embedded (iframe) in the Admin view. Grafana on :3000 (CONTEXT.md).
VITE_GRAFANA_URL=http://localhost:3000

# Idle session timeout (minutes) before auto-logout (FRONTEND-2 session controls).
VITE_IDLE_TIMEOUT_MINUTES=15
