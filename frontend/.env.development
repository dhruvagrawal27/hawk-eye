# Local dev defaults (vite dev). Mocks ON so the console runs end-to-end with no backend,
# serving the Part 24.5 sample payloads via MSW. Integration/prod builds use .env.production
# (mocks OFF) — never ship mocks as the default for integration builds (prompt §3, §10.4).
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_USE_MOCKS=true
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/hawk-eye
VITE_OIDC_CLIENT_ID=hawk-eye-console
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/login
VITE_OIDC_SCOPE=openid profile email
VITE_GRAFANA_URL=http://localhost:3000
VITE_IDLE_TIMEOUT_MINUTES=15
