# Hawk-Eye model-serving image (BACKEND-9). ONNX Runtime serving tier (port 8001).
FROM python:3.12-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONPATH=/app

RUN pip install --no-cache-dir "fastapi>=0.115,<1.0" "uvicorn[standard]>=0.32,<1.0" "pydantic>=2.7,<3"
# NOTE: add onnxruntime==1.20.* when ML delivers signed ONNX artifacts (Part 24.3).

COPY serving ./serving

EXPOSE 8001
CMD ["uvicorn", "serving.server:app", "--host", "0.0.0.0", "--port", "8001"]
