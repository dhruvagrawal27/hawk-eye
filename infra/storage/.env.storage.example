# Hawk-Eye storage-tier env (DATABASE). Copy to .env.storage for the standalone
# compose. Dev defaults only (golden rule 2: no real secrets). Mirrors the keys in
# the repo-root .env.example so the storage compose and PLATFORM's stack agree.
MINIO_ROOT_USER=hawkeye
MINIO_ROOT_PASSWORD=hawkeye_dev_pw
# 32-byte base64 local KMS key → SSE-S3 auto-encryption (swap to SSE-KMS in prod).
# MUST decode to EXACTLY 32 bytes or MinIO FATALs on boot (kms: invalid key length).
MINIO_KMS_SECRET_KEY=hawkeye-key:aGF3a2V5ZS1kZXYtbWluaW8tbWFzdGVyLWtleS0zMmI=

POSTGRES_USER=hawkeye
POSTGRES_PASSWORD=hawkeye_dev_pw
POSTGRES_DB=hawkeye

REDIS_PASSWORD=hawkeye_dev_pw
REDIS_MAXMEMORY=512mb

CLICKHOUSE_USER=hawkeye
CLICKHOUSE_PASSWORD=hawkeye_dev_pw

AWS_REGION=ap-south-1

# Image pins (mirror deploy/versions.bom.yaml).
MINIO_IMAGE=minio/minio:RELEASE.2024-12-18T13-15-44Z
MC_IMAGE=minio/mc:RELEASE.2024-12-18T13-15-44Z
POSTGRES_IMAGE=postgres:17.2
REDIS_IMAGE=redis:7.4.1-alpine
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:25.3
KAFKA_IMAGE=apache/kafka:3.8.1
PYTHON_IMAGE=python:3.12-slim
