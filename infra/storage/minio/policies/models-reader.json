{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyModelArtifacts",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectRetention"],
      "Resource": ["arn:aws:s3:::models/*"]
    },
    {
      "Sid": "ListModelsBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::models"]
    },
    {
      "Sid": "NoWriteNoDelete",
      "Effect": "Deny",
      "Action": ["s3:PutObject", "s3:DeleteObject", "s3:DeleteObjectVersion"],
      "Resource": ["arn:aws:s3:::models/*"]
    }
  ]
}
