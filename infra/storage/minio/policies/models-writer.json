{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListModelsBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketObjectLockConfiguration", "s3:GetBucketVersioning"],
      "Resource": ["arn:aws:s3:::models"]
    },
    {
      "Sid": "WriteSignedModelArtifacts",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:PutObjectRetention", "s3:GetObjectRetention"],
      "Resource": ["arn:aws:s3:::models/*"]
    },
    {
      "Sid": "NoDeleteOfModelVersions",
      "Effect": "Deny",
      "Action": ["s3:DeleteObject", "s3:DeleteObjectVersion", "s3:BypassGovernanceRetention"],
      "Resource": ["arn:aws:s3:::models/*"]
    }
  ]
}
