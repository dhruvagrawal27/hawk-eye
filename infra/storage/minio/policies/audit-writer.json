{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListAuditArchive",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketObjectLockConfiguration"],
      "Resource": ["arn:aws:s3:::audit-archive"]
    },
    {
      "Sid": "WriteAndLockSealedAuditRecords",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:PutObjectRetention", "s3:PutObjectLegalHold", "s3:GetObject", "s3:GetObjectRetention"],
      "Resource": ["arn:aws:s3:::audit-archive/*"]
    },
    {
      "Sid": "WORMNoDeleteNoBypass",
      "Effect": "Deny",
      "Action": ["s3:DeleteObject", "s3:DeleteObjectVersion", "s3:BypassGovernanceRetention", "s3:PutBucketObjectLockConfiguration"],
      "Resource": ["arn:aws:s3:::audit-archive", "arn:aws:s3:::audit-archive/*"]
    }
  ]
}
