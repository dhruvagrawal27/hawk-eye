# =============================================================================
# Hawk-Eye — environment template (PLATFORM / Laptop 06)
# Copy to `.env` at repo root for local runs:  cp .env.example .env
# -----------------------------------------------------------------------------
# GOLDEN RULE 2 (ON-PREM + SYNTHETIC ONLY): never put REAL secrets here.
# The three external secrets below are SCAFFOLD placeholders. In a running
# system they are served from Vault / AWS Secrets Manager (PLATFORM-12), never
# from this file. Compose reads them only for the local TEE-gateway scaffold.
# =============================================================================

# --- External LLM gateway secrets (SCAFFOLD — placeholders only) -------------
# Held in Vault dev (deploy/secrets) at runtime; never hardcoded, never committed.
NEAR_AI_API_KEY=dev-placeholder-near-ai-key-DO-NOT-USE
GROQ_API_KEY=dev-placeholder-groq-key-DO-NOT-USE
# PII tokenization key used by BACKEND's tokenizer (Part 25.3). Dev value only.
PII_HMAC_KEY=dev-only-hmac-key-rotate-in-vault-0123456789abcdef

# --- LLM gateway endpoints (egress allow-list = these two ONLY, PLATFORM-10) -
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# --- Core service credentials (dev defaults) ---------------------------------
POSTGRES_USER=hawkeye
POSTGRES_PASSWORD=hawkeye_dev_pw
POSTGRES_DB=hawkeye
GOVERNANCE_DB=governance

CLICKHOUSE_USER=hawkeye
CLICKHOUSE_PASSWORD=hawkeye_dev_pw

REDIS_PASSWORD=hawkeye_dev_pw

MINIO_ROOT_USER=hawkeye
MINIO_ROOT_PASSWORD=hawkeye_dev_pw

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_pw

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_dev_pw

VAULT_DEV_ROOT_TOKEN_ID=hawkeye-dev-root

# --- Degradation switch (PLATFORM-4/28) --------------------------------------
# When true, the pipeline runs L1-rules-only regardless of ML serving health.
DEGRADATION_FORCE_RULES_ONLY=false
ML_SERVING_HEALTH_URL=http://serving:8001/v2/health/ready

# --- TEE attestation mock (PLATFORM-14) --------------------------------------
TEE_ENCLAVE_MODE=true
TEE_CPU=intel-tdx
TEE_GPU=nvidia-h200

# --- Data residency (PLATFORM-9, Part 16) ------------------------------------
DATA_RESIDENCY=in-india
AWS_REGION=ap-south-1
