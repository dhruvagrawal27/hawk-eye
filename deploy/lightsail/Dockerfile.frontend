# Hawk-Eye — Frontend (React/Vite) built to static assets, served by nginx which also
# reverse-proxies /api and /ws to the backend. Build context = repo ROOT.
#   docker build -f deploy/lightsail/Dockerfile.frontend -t hawkeye/web:pilot .

# ---- stage 1: build the SPA ----
FROM node:20-slim AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
# Pilot talks to the real backend through nginx (no MSW mocks).
ENV VITE_USE_MOCKS=false \
    VITE_API_BASE_URL=/api/v1 \
    VITE_WS_BASE_URL=/ws/alerts
RUN npm run build

# ---- stage 2: serve ----
FROM nginx:1.27-alpine
COPY deploy/lightsail/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
