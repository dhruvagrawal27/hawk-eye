# Hawk-Eye — Frontend (React/Vite) built to static assets, served by nginx which also
# reverse-proxies /api and /ws to the backend. Build context = repo ROOT.
#   docker build -f deploy/lightsail/Dockerfile.frontend -t hawkeye/web:pilot .

# ---- stage 1: build the SPA ----
FROM node:20-slim AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
# The API/WS base are baked into the bundle at build time. Defaults assume a same-origin reverse
# proxy (/api/v1, /ws/alerts). For a SPLIT deploy (SPA and API on different subdomains) pass
# absolute URLs as build args, e.g.
#   --build-arg VITE_API_BASE_URL=https://hawk.nineagents.in/api/v1
#   --build-arg VITE_WS_BASE_URL=wss://hawk.nineagents.in/ws/alerts
ARG VITE_API_BASE_URL=/api/v1
ARG VITE_WS_BASE_URL=/ws/alerts
# VITE_USE_MOCKS=true builds a self-contained demo: MSW serves fixtures in-browser (persona
# picker login, no backend calls). Default false = the connected app hits the real API.
ARG VITE_USE_MOCKS=false
# Auth mode baked into the SPA: 'local' = username/password persona picker against the backend
# directory (no Keycloak) — the path a live URL uses with no IdP. Empty defers to env.ts's default
# (oidc iff VITE_OIDC_AUTHORITY is set, else local). 'oidc' forces Keycloak.
ARG VITE_AUTH_MODE=
ENV VITE_USE_MOCKS=${VITE_USE_MOCKS} \
    VITE_AUTH_MODE=${VITE_AUTH_MODE} \
    VITE_API_BASE_URL=${VITE_API_BASE_URL} \
    VITE_WS_BASE_URL=${VITE_WS_BASE_URL}
RUN npm run build

# ---- stage 2: serve ----
FROM nginx:1.27-alpine
COPY deploy/lightsail/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
