# =============================================================================
# Hawk-Eye — .env TEMPLATE for the Lightsail pilot.
#   cp deploy/lightsail/.env.example .env   (at the repo root)   then fill the blanks.
# This file is committed (no secrets). The real .env is gitignored — NEVER commit it.
# On the box: chmod 600 .env
# =============================================================================

# --- Public URL ----------------------------------------------------------
PUBLIC_BASE_URL=http://<your-lightsail-ip>

# --- LLM narrative gateway: NEAR AI (primary, TEE) -> Groq (fallback) -> template ---
LLM_PROVIDER=nearai
NEAR_AI_API_KEY=sk-...                     # https://cloud.near.ai  (out-of-credit -> auto-fails over to Groq)
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=gsk_...                       # https://console.groq.com/keys (the working fallback)
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- PII tokenization (HMAC-SHA256). Use a long random value in prod. -----
PII_HMAC_KEY=change-me-to-a-32+char-random-string

# --- Backend control plane (FastAPI reads HAWKEYE_* via pydantic Settings) ---
HAWKEYE_ENV=prod
HAWKEYE_API_BASE_PATH=/api/v1
HAWKEYE_LOG_LEVEL=INFO
# Pilot auth: local dev-JWT login (no Keycloak). Flip to keycloak once a realm is wired.
HAWKEYE_AUTH_MODE=local
HAWKEYE_DEV_JWT_SECRET=change-me-to-a-32+char-random-string
PREFLIGHT_MODE=1
# Wired automatically by docker-compose to the gateway service; left here for clarity.
HAWKEYE_NARRATIVE_REMOTE=true
HAWKEYE_NARRATIVE_URL=http://gateway:8002/narrate
HAWKEYE_NARRATIVE_TIMEOUT=15

# --- Scoring threshold (carried from the tuned model) --------------------
SCORE_THRESHOLD=0.16032509001471132

# --- Frontend (baked into the SPA at build time) -------------------------
VITE_USE_MOCKS=false
VITE_API_BASE_URL=/api/v1
VITE_WS_BASE_URL=/ws
